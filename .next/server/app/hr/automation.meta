{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/hr/layout,_N_T_/hr/automation/layout,_N_T_/hr/automation/page,_N_T_/hr/automation"
  },
  "segmentPaths": [
