{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/timeclock/layout,_N_T_/timeclock/page,_N_T_/timeclock"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/timeclock/__PAGE__",
    "/timeclock",
    "/_index",
    "/_head"
  ]
}