{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/basecamp/layout,_N_T_/basecamp/page,_N_T_/basecamp"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/basecamp/__PAGE__",
    "/basecamp",
    "/_index",
    "/_head"
  ]
}